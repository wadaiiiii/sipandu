@php
    $requestBasePath = trim((string) request()->getBaseUrl(), '/');
    $configuredBasePath = trim((string) config('sipandu.base_path', ''), '/');

    $sipanduBasePath = $requestBasePath !== ''
        ? $requestBasePath
        : $configuredBasePath;

    $sipanduBasePath = $sipanduBasePath !== ''
        ? '/'.$sipanduBasePath
        : '';
@endphp


<meta name="app-base-currentPath" content="{{ $sipanduBasePath }}">


<script>
window.__SIPANDU_API_PREFIX__ = '/sipandu-api/';
window.__SIPANDU_BASE_PATH__ = @json($sipanduBasePath);


window.sipanduUrl = function(value){

    if(typeof value !== 'string'){
        return value;
    }

    if(value.startsWith('/akademik/')){
        return value;
    }

    const currentPath = value;

    if(typeof value !== 'string'){
        return value;
    }


    if(!currentPath.startsWith('/')){
        return value;
    }
    if(value.startsWith('/akademik/')){
        return value;
    }

    const currentPath = value;
    if(value.startsWith('/akademik/')){
        return value;
    }

    const currentPath = value;

    const base = window.__SIPANDU_BASE_PATH__ || '';


    if(!base){
        return value;
    }


    if(currentPath === base || currentPath.startsWith(base+'/')){
        return value;
    }


    return base + currentPath;

};

</script>



