APP_NAME=SiPANDU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For production PostgreSQL, SiPANDU accepts DB_URL, DATABASE_URL, or POSTGRES_URL.
DB_URL=
DATABASE_URL=
POSTGRES_URL=
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SIPANDU_ADMIN_NAME="Admin Prodi"
SIPANDU_ADMIN_EMAIL=
SIPANDU_ADMIN_PASSWORD=

# Temporary production bootstrap. Disable after setup succeeds.
SIPANDU_SETUP_ENABLED=false
SIPANDU_SETUP_TOKEN=

# Optional RPS integrations. SiPANDU remains usable when these are empty.
SIMATRPS_BASE_URL=https://simatrps.vercel.app
SIMATRPS_TOKEN=
EXTERNAL_RPS_BASE_URL=
EXTERNAL_RPS_TOKEN=

# SSO — Authorization Code + PKCE against SiMatRPS.
SIMATRPS_SSO_REDIRECT_URI=http://localhost/sso/callback
