APP_NAME=SiPANDU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SIPANDU_ADMIN_NAME="Admin Prodi"
SIPANDU_ADMIN_EMAIL=
SIPANDU_ADMIN_PASSWORD=

# Optional RPS integrations. SiPANDU remains usable when these are empty.
SIMATRPS_BASE_URL=
SIMATRPS_TOKEN=
EXTERNAL_RPS_BASE_URL=
EXTERNAL_RPS_TOKEN=
