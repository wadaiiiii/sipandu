APP_NAME=SiPANDU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional. Leave empty at root. For UNSULBAR use /akademik/sipandu.
APP_BASE_PATH=
# Optional asset root. For UNSULBAR use https://matematika.unsulbar.ac.id/akademik/sipandu
ASSET_URL=
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For production PostgreSQL, SiPANDU accepts DB_URL, DATABASE_URL, or POSTGRES_URL.
DB_URL=
DATABASE_URL=
POSTGRES_URL=
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=file
SESSION_COOKIE=sipandu_session
# At UNSULBAR use /akademik/sipandu so the cookie does not affect other applications.
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# vercel_blob keeps current Vercel behavior. Use local_private on persistent UNSULBAR hosting.
SIPANDU_FILE_STORAGE=vercel_blob

SIPANDU_ADMIN_NAME="Admin Prodi"
SIPANDU_ADMIN_EMAIL=
SIPANDU_ADMIN_PASSWORD=

# Temporary production bootstrap. Disable after setup succeeds.
SIPANDU_SETUP_ENABLED=false
SIPANDU_SETUP_TOKEN=

# Optional RPS integrations. SiPANDU remains usable when these are empty.
SIMATRPS_BASE_URL=https://matematika.unsulbar.ac.id/akademik/simatrps
SIMATRPS_TOKEN=
EXTERNAL_RPS_BASE_URL=
EXTERNAL_RPS_TOKEN=

# SSO — Authorization Code + PKCE against SiMatRPS.
# Leave empty to derive automatically from APP_URL + /sso/callback.
SIMATRPS_SSO_REDIRECT_URI=
